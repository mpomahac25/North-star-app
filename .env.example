BACKEND_URL=http://localhost:3001
LOGIN_SERVICE_URL=http://localhost:3003
MOVIES_API_URL=http://localhost:3005

# Service ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
BOOKING_PORT=3002
LOGIN_PORT=3003
PAYMENT_PORT=3004
MOVIES_API_PORT=3005

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Gmail API email verification uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com
GMAIL_SENDER_NAME=Rio Theaters

# PostgreSQL configuration
POSTGRES_DB=rio_theaters
POSTGRES_USER=rio
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST_PORT=5433
ENCRYPTION_KEY=replace_with_64_hex_characters_for_a_32_byte_key

# Docker Hub
DOCKERHUB_USERNAME=your_username

# OpenMovie DB
OMDB_API_KEY=your_omdb_api_key
